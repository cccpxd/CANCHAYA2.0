# Copia este archivo como .env y ajusta los valores.
# El .env NO se sube al repositorio.

DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos (los valores por defecto coinciden con compose.yaml)
DB_NAME=canchaYA
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=5433

# Administrador. Con estos valores, `python manage.py crear_administrador`
# no pregunta nada y crea (o actualiza) esta cuenta.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cancha2026
ADMIN_EMAIL=admin@canchaya.com

# Calendario de disponibilidad
DURACION_FRANJA_MINUTOS=60
HORARIO_APERTURA=06:00
HORARIO_CIERRE=23:00
